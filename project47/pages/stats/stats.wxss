.container {
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.container.light-mode {
  background-color: #f5f5f5;
}

.container.dark-mode {
  background-color: #1a1a1a;
}

.header-card {
  text-align: center;
  padding: 40rpx 0;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.header-desc {
  font-size: 26rpx;
  color: var(--text-muted);
}

.total-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 40rpx 20rpx;
  margin-bottom: 30rpx;
}

.total-item {
  flex: 1;
  text-align: center;
}

.total-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.total-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.total-divider {
  width: 2rpx;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

.stats-section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  padding: 10rpx 20rpx;
  margin-bottom: 10rpx;
}

.stats-card {
  display: flex;
  background: var(--card-bg);
  border-radius: 16rpx;
  overflow: hidden;
}

.stat-item {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  border-right: 1rpx solid var(--border-light);
}

.stat-item:last-child {
  border-right: none;
}

.stat-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.stat-info {
  display: flex;
  flex-direction: column;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.tips-card {
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 20rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.tips-content {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}
