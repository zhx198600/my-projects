.container {
  min-height: 100vh;
}

.container.light-mode {
  background-color: #f5f5f5;
}

.container.dark-mode {
  background-color: #1a1a1a;
}

.search-entry {
  padding: 20rpx;
  background-color: var(--bg-secondary);
  position: sticky;
  top: 0;
  z-index: 101;
}

.search-entry-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background-color: var(--bg-tertiary);
}

.search-entry .search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  font-size: 26rpx;
  color: var(--text-muted);
}

.category-scroll {
  background-color: var(--bg-secondary);
  position: sticky;
  top: 112rpx;
  z-index: 100;
  border-bottom: 1rpx solid var(--border-color);
  backdrop-filter: blur(10rpx);
}

.container {
  padding-bottom: 120rpx;
}

.category-list {
  display: flex;
  padding: 0 20rpx;
  white-space: nowrap;
}

.category-item {
  flex-shrink: 0;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
}

.category-item.active {
  color: var(--primary-color);
  font-weight: bold;
}

.category-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: var(--primary-color);
  border-radius: 3rpx;
}

.news-list {
  padding: 20rpx;
}

.news-item {
  display: flex;
  background-color: var(--card-bg);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx var(--shadow-color);
}

.news-cover {
  width: 200rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.news-cover image {
  width: 100%;
  height: 100%;
}

.news-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.news-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.news-summary {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.5;
  margin-top: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.news-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}

.meta-source {
  font-size: 22rpx;
  color: var(--primary-color);
}

.meta-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.loading-more,
.no-more,
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}

.loading-more text,
.no-more text,
.empty-state text {
  font-size: 26rpx;
  color: var(--text-muted);
}
