.container {
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.container.light-mode {
  background-color: var(--bg-primary);
}

.container.dark-mode {
  background-color: var(--bg-primary);
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 10rpx 30rpx;
}

.header-title {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.clear-btn {
  font-size: 28rpx;
  color: var(--primary-color);
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.news-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 16rpx;
  background-color: var(--card-bg);
  box-shadow: 0 2rpx 12rpx var(--shadow-color);
  position: relative;
}

.news-cover {
  width: 180rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.news-cover image {
  width: 100%;
  height: 100%;
}

.news-content {
  flex: 1;
  margin-left: 24rpx;
  margin-right: 60rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 120rpx;
}

.news-title {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.news-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}

.meta-source {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.meta-time {
  font-size: 24rpx;
  color: var(--text-muted);
}

.remove-btn {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: var(--bg-tertiary);
}

.remove-icon {
  font-size: 36rpx;
  color: var(--text-muted);
  line-height: 1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-muted);
}
