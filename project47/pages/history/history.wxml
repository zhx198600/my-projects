<view class="container {{isDarkMode ? 'dark-mode' : 'light-mode'}}">
  <view class="header" wx:if="{{history.length > 0}}">
    <text class="header-title">共 {{history.length}} 条记录</text>
    <text class="clear-btn" bindtap="clearHistory">清空</text>
  </view>

  <view class="history-list" wx:if="{{history.length > 0}}">
    <view 
      class="news-item" 
      wx:for="{{history}}" 
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onNewsTap"
    >
      <view class="news-cover">
        <image src="{{item.coverImage}}" mode="aspectFill"></image>
      </view>
      <view class="news-content">
        <view class="news-title">{{item.title}}</view>
        <view class="news-meta">
          <text class="meta-source">{{item.source}}</text>
          <text class="meta-time">{{item.publishTime}}</text>
        </view>
      </view>
      <view class="remove-btn" catchtap="removeHistory" data-id="{{item.id}}">
        <text class="remove-icon">×</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{history.length === 0}}">
    <text class="empty-icon">📖</text>
    <text class="empty-text">暂无浏览记录</text>
    <text class="empty-desc">快去看看你感兴趣的新闻吧</text>
  </view>
</view>
