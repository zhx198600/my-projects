<view class="container {{isDarkMode ? 'dark-mode' : 'light-mode'}}">
  <view class="header">
    <text class="title">为你推荐</text>
    <view class="recommend-tags" wx:if="{{hasHistory && recommendCategories.length > 0}}">
      <text class="tag" wx:for="{{recommendCategories}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-container">
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{recommendList.length === 0}}" class="empty-tip">
    <text class="empty-icon">✨</text>
    <text class="empty-text">暂无推荐内容</text>
    <text class="empty-desc">多阅读一些新闻，我们会为你推荐更感兴趣的内容</text>
  </view>

  <view wx:else class="recommend-list">
    <view 
      class="recommend-item" 
      wx:for="{{recommendList}}" 
      wx:key="id"
      bindtap="goToDetail"
      data-id="{{item.id}}"
    >
      <view class="item-cover">
        <image src="{{item.coverImage}}" mode="aspectFill"></image>
      </view>
      <view class="item-content">
        <text class="item-title">{{item.title}}</text>
        <view class="item-meta">
          <text class="item-source">{{item.source}}</text>
          <text class="item-time">{{item.publishTime}}</text>
        </view>
        <view class="item-reason">
          <text class="reason-icon">💡</text>
          <text class="reason-text">{{item.recommendReason}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
