.detail-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.detail-container.light-mode {
  background-color: #f8f9fa;
}

.detail-container.dark-mode {
  background-color: #1a1a1a;
}

.font-toolbar {
  position: fixed;
  top: 0;
  right: 0;
  z-index: 100;
  padding: 20rpx;
}

.font-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  background-color: var(--bg-secondary);
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx var(--shadow-color);
}

.font-icon {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1;
}

.font-label {
  font-size: 20rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.font-selector {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.font-selector.show {
  opacity: 1;
  visibility: visible;
}

.font-selector-content {
  margin-top: 120rpx;
  margin-right: 20rpx;
  background-color: var(--bg-secondary);
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 32rpx var(--shadow-color);
  min-width: 300rpx;
}

.font-selector-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  margin-bottom: 24rpx;
  text-align: center;
}

.font-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.font-option {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background-color: var(--bg-primary);
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.font-option.active {
  background-color: var(--primary-color);
}

.font-option.active .option-text {
  color: #fff;
}

.option-text {
  color: var(--text-primary);
  font-weight: 500;
}

.detail-scroll {
  flex: 1;
  box-sizing: border-box;
  padding-bottom: 400rpx;
}

.detail-header {
  background-color: var(--bg-secondary);
  padding: 40rpx 30rpx 30rpx;
}

.detail-title {
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.detail-title.font-small {
  font-size: 32rpx;
}

.detail-title.font-medium {
  font-size: 38rpx;
}

.detail-title.font-large {
  font-size: 44rpx;
}

.detail-title.font-xlarge {
  font-size: 52rpx;
}

.detail-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.meta-source {
  font-size: 24rpx;
  color: var(--primary-color);
  padding: 6rpx 16rpx;
  background-color: var(--primary-bg);
  border-radius: 8rpx;
}

.meta-time {
  font-size: 24rpx;
  color: var(--text-muted);
}

.detail-cover {
  width: 100%;
  height: 420rpx;
  overflow: hidden;
}

.detail-cover image {
  width: 100%;
  height: 100%;
}

.detail-content {
  background-color: var(--bg-secondary);
  margin-top: 16rpx;
  padding: 30rpx;
  color: var(--text-primary);
}

.detail-content.font-small {
  font-size: 28rpx;
  line-height: 1.8;
}

.detail-content.font-medium {
  font-size: 32rpx;
  line-height: 1.85;
}

.detail-content.font-large {
  font-size: 36rpx;
  line-height: 1.9;
}

.detail-content.font-xlarge {
  font-size: 42rpx;
  line-height: 2;
}

.detail-bottom-space {
  height: 200rpx;
}

.comment-section {
  margin-top: 20rpx;
  background-color: var(--bg-secondary);
  padding: 30rpx;
}

.section-header {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.comment-item {
  display: flex;
  gap: 20rpx;
}

.comment-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.comment-content {
  flex: 1;
  min-width: 0;
}

.comment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.comment-nickname {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.comment-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.comment-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.comment-actions {
  display: flex;
  gap: 30rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 24rpx;
}

.action-text {
  font-size: 22rpx;
  color: var(--text-muted);
}

.reply-list {
  margin-top: 20rpx;
  padding: 20rpx;
  background-color: var(--bg-primary);
  border-radius: 12rpx;
}

.reply-item {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.reply-item:last-child {
  margin-bottom: 0;
}

.reply-nickname {
  color: var(--primary-color);
  font-weight: 500;
}

.reply-to {
  color: var(--text-muted);
  margin: 0 8rpx;
}

.reply-content {
  color: var(--text-primary);
}

.empty-comments {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-comments .empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-comments .empty-text {
  font-size: 28rpx;
  color: var(--text-muted);
}

.comment-input-bar {
  position: fixed;
  bottom: 100rpx;
  left: 0;
  right: 0;
  background-color: var(--bg-secondary) !important;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 -2rpx 16rpx var(--shadow-color);
  z-index: 98;
  opacity: 1;
}

.comment-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background-color: var(--bg-primary);
  border-radius: 36rpx;
  font-size: 28rpx;
  color: var(--text-primary);
}

.reply-cancel {
  font-size: 26rpx;
  color: var(--text-muted);
  padding: 10rpx;
}

.send-btn {
  padding: 16rpx 32rpx;
  background-color: var(--bg-primary);
  border-radius: 36rpx;
  font-size: 28rpx;
  color: var(--text-muted);
}

.send-btn.active {
  background-color: var(--primary-color);
  color: #fff;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: var(--bg-secondary) !important;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 -2rpx 16rpx var(--shadow-color);
  z-index: 99;
  padding-bottom: env(safe-area-inset-bottom);
  opacity: 1;
}

.bar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
}

.btn-icon {
  font-size: 36rpx;
  line-height: 1;
}

.btn-text {
  font-size: 22rpx;
  margin-top: 6rpx;
}

.back-btn .btn-icon {
  color: var(--text-primary);
}

.back-btn .btn-text {
  color: var(--text-secondary);
}

.like-btn .btn-icon {
  color: var(--text-muted);
}

.like-btn .btn-text {
  color: var(--text-muted);
}

.like-btn.liked .btn-icon {
  color: #ff4d4f;
}

.like-btn.liked .btn-text {
  color: #ff4d4f;
}

.comment-btn .btn-icon {
  color: var(--text-muted);
}

.comment-btn .btn-text {
  color: var(--text-muted);
}

.favorite-btn .btn-icon {
  color: var(--text-muted);
}

.favorite-btn .btn-text {
  color: var(--text-muted);
}

.favorite-btn.favorited .btn-icon {
  color: #faad14;
}

.favorite-btn.favorited .btn-text {
  color: #faad14;
}

.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-muted);
}
