.container {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

.container.light-mode {
  background-color: #f5f5f5;
}

.container.dark-mode {
  background-color: #1a1a1a;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.add-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 40rpx;
  color: #fff;
  line-height: 1;
}

.keyword-count {
  padding: 10rpx 20rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.keywords-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 20rpx;
  background: var(--card-bg);
  border-radius: 16rpx;
}

.keyword-item {
  position: relative;
  padding: 16rpx 40rpx 16rpx 24rpx;
  background: var(--primary-bg);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  transition: all 0.2s ease;
}

.keyword-text {
  font-size: 28rpx;
  color: var(--primary-color);
}

.delete-btn {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1;
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-muted);
  opacity: 0.7;
}

.news-header {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx 10rpx 0;
}

.back-icon {
  font-size: 36rpx;
  color: var(--primary-color);
  line-height: 1;
}

.back-text {
  font-size: 28rpx;
  color: var(--primary-color);
  margin-left: 8rpx;
}

.news-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  text-align: center;
  padding-right: 80rpx;
}

.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-muted);
}

.news-list {
  background: var(--card-bg);
  border-radius: 16rpx;
  overflow: hidden;
}

.news-item {
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.news-item:last-child {
  border-bottom: none;
}

.news-content {
  display: flex;
  flex-direction: column;
}

.news-title-text {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.news-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.news-source {
  font-size: 24rpx;
  color: var(--primary-color);
}

.news-time {
  font-size: 24rpx;
  color: var(--text-muted);
}

.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.dialog-mask.show {
  opacity: 1;
  visibility: visible;
}

.dialog-content {
  width: 600rpx;
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 30rpx;
}

.dialog-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: var(--bg-primary);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  margin-bottom: 30rpx;
}

.dialog-actions {
  display: flex;
  gap: 20rpx;
}

.dialog-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.cancel-btn {
  background: var(--bg-primary);
  color: var(--text-secondary);
}

.confirm-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.container {
  padding-bottom: 120rpx;
}
