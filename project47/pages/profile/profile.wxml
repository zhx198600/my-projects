<view class="container {{isDarkMode ? 'dark-mode' : 'light-mode'}}">
  <view class="user-card" bindtap="handleLogin">
    <view class="avatar">
      <text class="avatar-placeholder">{{userInfo.nickName.charAt(0)}}</text>
    </view>
    <view class="user-info">
      <text class="nickname">{{userInfo.nickName}}</text>
      <text class="desc">欢迎使用新闻资讯</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="stats-card">
    <view class="stats-item">
      <view class="stats-value">{{formatDuration(stats.today.duration)}}</view>
      <view class="stats-label">今日阅读</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <view class="stats-value">{{stats.today.count}}</view>
      <view class="stats-label">今日篇数</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <view class="stats-value">{{stats.totalCount}}</view>
      <view class="stats-label">累计阅读</view>
    </view>
  </view>
  
  <view class="menu-section">
    <view class="menu-item" wx:for="{{menuList}}" wx:key="id" bindtap="handleMenuTap" data-path="{{item.path}}">
      <view class="menu-left">
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-title">{{item.title}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
