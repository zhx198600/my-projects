<view class="container {{isDarkMode ? 'dark-mode' : 'light-mode'}}">
  <view class="section">
    <view class="section-title">显示设置</view>
    <view class="setting-card">
      <view class="setting-item">
        <view class="item-left">
          <text class="item-icon">🌙</text>
          <text class="item-label">夜间模式</text>
        </view>
        <switch 
          class="item-switch" 
          checked="{{isDarkMode}}" 
          bindchange="toggleDarkMode"
          color="#667eea"
        />
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">内容过滤</view>
    <view class="setting-card">
      <view class="setting-item">
        <view class="item-left">
          <text class="item-icon">🚫</text>
          <text class="item-label">过滤关键词</text>
        </view>
        <text class="item-count">{{filterKeywords.length}}个</text>
      </view>
      
      <view class="filter-keywords">
        <view 
          class="filter-tag" 
          wx:for="{{filterKeywords}}" 
          wx:key="*this"
        >
          <text class="tag-text">{{item}}</text>
          <view class="tag-delete" catchtap="removeFilterKeyword" data-keyword="{{item}}">
            <text>×</text>
          </view>
        </view>
        <view class="add-filter-btn" bindtap="showAddFilterDialog">
          <text class="add-icon">+</text>
          <text>添加</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">数据管理</view>
    <view class="setting-card">
      <view class="setting-item" bindtap="goToStats">
        <view class="item-left">
          <text class="item-icon">📊</text>
          <text class="item-label">阅读统计</text>
        </view>
        <text class="item-arrow">›</text>
      </view>
      <view class="setting-item" bindtap="clearCache">
        <view class="item-left">
          <text class="item-icon">🗑️</text>
          <text class="item-label">清除缓存</text>
        </view>
        <text class="item-value">{{cacheSize}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">其他</view>
    <view class="setting-card">
      <view class="setting-item" bindtap="showFeedback">
        <view class="item-left">
          <text class="item-icon">💬</text>
          <text class="item-label">意见反馈</text>
        </view>
        <text class="item-arrow">›</text>
      </view>
      <view class="setting-item" bindtap="showAbout">
        <view class="item-left">
          <text class="item-icon">ℹ️</text>
          <text class="item-label">关于我们</text>
        </view>
        <text class="item-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="version-info">
    <text>版本 v1.0.0</text>
  </view>

  <view class="dialog-mask {{showAddFilterDialog ? 'show' : ''}}" bindtap="hideAddFilterDialog">
    <view class="dialog-content" catchtap="stopDialogTap">
      <view class="dialog-title">添加过滤关键词</view>
      <input 
        class="dialog-input" 
        placeholder="请输入关键词" 
        value="{{newFilterKeyword}}"
        bindinput="onFilterKeywordInput"
        maxlength="20"
        focus="{{showAddFilterDialog}}"
      />
      <view class="dialog-tip">包含该关键词的新闻将被过滤</view>
      <view class="dialog-actions">
        <view class="dialog-btn cancel-btn" bindtap="hideAddFilterDialog">
          <text>取消</text>
        </view>
        <view class="dialog-btn confirm-btn" bindtap="addFilterKeyword">
          <text>确定</text>
        </view>
      </view>
    </view>
  </view>
</view>
