.container {
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.container.light-mode {
  background-color: #f5f5f5;
}

.container.dark-mode {
  background-color: #1a1a1a;
}

.section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 24rpx;
  color: var(--text-muted);
  padding: 10rpx 20rpx;
  margin-bottom: 10rpx;
}

.setting-card {
  background: var(--card-bg);
  border-radius: 16rpx;
  overflow: hidden;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.setting-item:last-child {
  border-bottom: none;
}

.item-left {
  display: flex;
  align-items: center;
}

.item-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.item-label {
  font-size: 30rpx;
  color: var(--text-primary);
}

.item-count {
  font-size: 26rpx;
  color: var(--text-muted);
}

.item-value {
  font-size: 26rpx;
  color: var(--text-muted);
}

.item-arrow {
  font-size: 36rpx;
  color: var(--text-muted);
}

.filter-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx 30rpx 30rpx;
  border-top: 1rpx solid var(--border-light);
}

.filter-tag {
  position: relative;
  display: flex;
  align-items: center;
  padding: 12rpx 36rpx 12rpx 20rpx;
  background: var(--bg-primary);
  border-radius: 8rpx;
}

.tag-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.tag-delete {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--text-muted);
}

.add-filter-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  border: 2rpx dashed var(--border-color);
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--text-muted);
}

.add-filter-btn .add-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.version-info {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: var(--text-muted);
}

.dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.dialog-mask.show {
  opacity: 1;
  visibility: visible;
}

.dialog-content {
  width: 600rpx;
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.dialog-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 30rpx;
}

.dialog-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: var(--bg-primary);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.dialog-tip {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 30rpx;
}

.dialog-actions {
  display: flex;
  gap: 20rpx;
}

.dialog-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.cancel-btn {
  background: var(--bg-primary);
  color: var(--text-secondary);
}

.confirm-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}
