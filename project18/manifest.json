{
  "manifest_version": 3,
  "name": "浏览器截图插件",
  "version": "1.0.0",
  "description": "支持区域截图、滚动截图、图片标注、导出PNG/PDF的浏览器截图工具",
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "permissions": ["activeTab", "scripting", "downloads"],
  "action": {
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    },
    "default_title": "截取当前页面"
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "all_frames": false,
      "run_at": "document_start",
      "match_about_blank": true
    }
  ],
  "minimum_chrome_version": "88"
}